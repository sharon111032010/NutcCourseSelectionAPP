<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="12dp"
            android:paddingEnd="10dp"
            android:paddingBottom="24dp">

        <!-- 統計列 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_stats"
            android:orientation="horizontal"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStatCourses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_stat_courses"
                    android:textColor="#C9D6E2"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStatMine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_stat_mine"
                    android:textColor="#C9D6E2"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStatCredits"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_stat_credits"
                    android:textColor="#C9D6E2"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStatConflicts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_stat_conflicts"
                    android:textColor="#C9D6E2"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- 假搜尋列，點了進搜尋頁 -->
        <TextView
            android:id="@+id/tvFakeSearch"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_margin="6dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_outline"
            android:drawablePadding="10dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/home_search_bar"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            style="@style/Text.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:text="功能" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSearch"
            style="@style/HomeCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/HomeCardIcon"
                    android:text="🔍" />

                <TextView
                    style="@style/HomeCardTitle"
                    android:text="@string/home_search" />

                <TextView
                    style="@style/HomeCardSub"
                    android:text="@string/home_search_sub" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFilter"
            style="@style/HomeCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/HomeCardIcon"
                    android:text="🎛" />

                <TextView
                    style="@style/HomeCardTitle"
                    android:text="@string/home_filter" />

                <TextView
                    style="@style/HomeCardSub"
                    android:text="@string/home_filter_sub" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBrowse"
            style="@style/HomeCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/HomeCardIcon"
                    android:text="🏫" />

                <TextView
                    style="@style/HomeCardTitle"
                    android:text="@string/home_browse" />

                <TextView
                    style="@style/HomeCardSub"
                    android:text="@string/home_browse_sub" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGe"
            style="@style/HomeCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/HomeCardIcon"
                    android:text="🎨" />

                <TextView
                    style="@style/HomeCardTitle"
                    android:text="@string/home_ge" />

                <TextView
                    style="@style/HomeCardSub"
                    android:text="@string/home_ge_sub" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSchedule"
            style="@style/HomeCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/HomeCardIcon"
                    android:text="📅" />

                <TextView
                    style="@style/HomeCardTitle"
                    android:text="@string/home_schedule" />

                <TextView
                    style="@style/HomeCardSub"
                    android:text="@string/home_schedule_sub" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSelected"
            style="@style/HomeCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/HomeCardIcon"
                    android:text="🧮" />

                <TextView
                    style="@style/HomeCardTitle"
                    android:text="@string/home_selected" />

                <TextView
                    style="@style/HomeCardSub"
                    android:text="@string/home_selected_sub" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardConflicts"
            style="@style/HomeCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/HomeCardIcon"
                    android:text="⚠" />

                <TextView
                    style="@style/HomeCardTitle"
                    android:text="@string/home_conflicts" />

                <TextView
                    style="@style/HomeCardSub"
                    android:text="@string/home_conflicts_sub" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFavorites"
            style="@style/HomeCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/HomeCardIcon"
                    android:text="⭐" />

                <TextView
                    style="@style/HomeCardTitle"
                    android:text="@string/home_favorites" />

                <TextView
                    style="@style/HomeCardSub"
                    android:text="@string/home_favorites_sub" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSettings"
            style="@style/HomeCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/HomeCardIcon"
                    android:text="⚙" />

                <TextView
                    style="@style/HomeCardTitle"
                    android:text="@string/home_settings" />

                <TextView
                    style="@style/HomeCardSub"
                    android:text="@string/home_settings_sub" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAbout"
            style="@style/HomeCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/HomeCardIcon"
                    android:text="ℹ" />

                <TextView
                    style="@style/HomeCardTitle"
                    android:text="@string/home_about" />

                <TextView
                    style="@style/HomeCardSub"
                    android:text="@string/home_about_sub" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView
            android:id="@+id/tvDataInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
